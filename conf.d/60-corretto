NAME="corretto"
DOWNLOAD="https://corretto.aws/downloads/resources/{VERSION}/amazon-corretto-{VERSION}-linux-x64.tar.gz"
CHECKSUM="corretto-verify.sh"
VERSION_CHECK="corretto-check.sh"
INSTALL_DIR="${OOB_LIVE}/${NAME}"
SYMLINKS="java:amazon-corretto-{VERSION}-linux-x64/bin/java|javac:amazon-corretto-{VERSION}-linux-x64/bin/javac"
SYMLINK_DIR="/usr/local/bin"

#
# After developing this, I found out Corretto has had apt repos for quite some time.
# I've been doing it the hard way for many years, likely before the apt repo was 
# available or just didn't read about it.  That's probably the better way to go
# than using oob so you can find out more about it here:
# apt repos too: https://docs.aws.amazon.com/corretto/latest/corretto-11-ug/generic-linux-install.html
#
# Uncomment the following to register corretto with update-alternatives.
# This is the standard Debian way to manage multiple Java installs.
# Run these manually after 'oob install corretto' completes:
#
#   JAVA_HOME=$(echo /usr/local/apt-oob/live/corretto/amazon-corretto-*-linux-x64)
#   update-alternatives --install /usr/bin/java java "${JAVA_HOME}/bin/java" 1
#   update-alternatives --install /usr/bin/javac javac "${JAVA_HOME}/bin/javac" 1
#   echo "export JAVA_HOME=${JAVA_HOME}" > /etc/profile.d/java-home.sh
#
# If another Java is already installed, select corretto as the active one:
#   update-alternatives --config java

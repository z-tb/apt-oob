#!/bin/bash
set -euo pipefail

# --- Globals (defaults, overridable via /etc/apt-oob.conf or environment) ---
: "${OOB_BASE:="/usr/local/apt-oob"}"
: "${LOG_FILE:="/var/log/apt-oob.log"}"

# Source global config if it exists (before deriving paths)
[[ -f /etc/apt-oob.conf ]] && source /etc/apt-oob.conf

OOB_CONF="${OOB_BASE}/conf.d"
OOB_CHECKVER="${OOB_BASE}/checkver"
OOB_DLOAD="${OOB_BASE}/dload"
OOB_CHECKSUM="${OOB_BASE}/checksum"
OOB_KEYS="${OOB_BASE}/keys"
OOB_LIVE="${OOB_BASE}/live"
OOB_STATE="${OOB_BASE}/state"
APT_HOOK="/etc/apt/apt.conf.d/99-apt-oob"

FLAG_FORCE=0
FLAG_DRYRUN=0
FLAG_VERBOSE=0
FLAG_QUIET=0
FLAG_TERSE=0

OOB_VERSION="0.1.0"

# Banner style: none, simple, fancy (default: fancy)
: "${BANNER:="fancy"}"

# --- Color codes (set to empty for no color) ---
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_CYAN='\033[0;36m'
C_MAGENTA='\033[0;35m'
C_WHITE='\033[1;37m'
C_RESET='\033[0m'

# --- Output functions ---
_log() {
    local level="$1"; shift
    local msg="$*"
    local ts
    ts=$(date '+%b %d %H:%M:%S')
    echo "${ts} oob[$$]: [${level}] ${msg}" >> "$LOG_FILE" 2>/dev/null || true
}

info() {
    _log "INFO" "$*"
    if (( FLAG_QUIET )); then return; fi
    if (( FLAG_TERSE )); then return; fi
    printf "${C_CYAN}%s${C_RESET}\n" "$*"
}

warn() {
    _log "WARN" "$*"
    if (( FLAG_QUIET )); then return; fi
    if (( FLAG_TERSE )); then printf "${C_YELLOW}apt-oob: warning: %s${C_RESET}\n" "$*"; return; fi
    printf "${C_YELLOW}%s${C_RESET}\n" "$*" >&2
}

error() {
    _log "ERROR" "$*"
    if (( FLAG_QUIET )); then return; fi
    if (( FLAG_TERSE )); then printf "${C_RED}apt-oob: error: %s${C_RESET}\n" "$*"; return; fi
    printf "${C_RED}%s${C_RESET}\n" "$*" >&2
}

success() {
    _log "INFO" "$*"
    if (( FLAG_QUIET )); then return; fi
    if (( FLAG_TERSE )); then echo "apt-oob: $*"; return; fi
    printf "${C_GREEN}%s${C_RESET}\n" "$*"
}

highlight() {
    _log "INFO" "$*"
    if (( FLAG_QUIET )); then return; fi
    if (( FLAG_TERSE )); then echo "apt-oob: $*"; return; fi
    printf "${C_MAGENTA}%s${C_RESET}\n" "$*"
}

bold() {
    _log "INFO" "$*"
    if (( FLAG_QUIET )); then return; fi
    if (( FLAG_TERSE )); then return; fi
    printf "${C_WHITE}%s${C_RESET}\n" "$*"
}

# Formatted print with inline color tokens: {RED}, {GREEN}, {YELLOW}, {CYAN}, {MAGENTA}, {WHITE}, {RESET}
# Prints in all modes except quiet. In terse mode, tokens are stripped and prefixed with "apt-oob:".
# First arg is log level (INFO, WARN, ERROR), rest is the message.
fmt_print() {
    local level="$1"; shift
    local msg="$*"
    local plain
    plain=$(echo "$msg" | sed 's/{[A-Z]*}//g')
    _log "$level" "$plain"
    if (( FLAG_QUIET )); then return; fi
    if (( FLAG_TERSE )); then
        echo "apt-oob: ${plain}"
        return
    fi
    msg="${msg//\{RED\}/$C_RED}"
    msg="${msg//\{GREEN\}/$C_GREEN}"
    msg="${msg//\{YELLOW\}/$C_YELLOW}"
    msg="${msg//\{CYAN\}/$C_CYAN}"
    msg="${msg//\{MAGENTA\}/$C_MAGENTA}"
    msg="${msg//\{WHITE\}/$C_WHITE}"
    msg="${msg//\{RESET\}/$C_RESET}"
    printf "%b\n" "$msg"
}

# --- Spinner (dot bounce) ---
SPIN_PID=""
SPIN_FRAMES=("⠁" "⠂" "⠄" "⡀" "⢀" "⠠" "⠐" "⠈")

_spinner() {
    local msg="$1"
    local i=0
    local count=${#SPIN_FRAMES[@]}
    while true; do
        printf "\r${C_CYAN}%s${C_RESET} %s " "$msg" "${SPIN_FRAMES[i % count]}"
        i=$((i + 1))
        sleep 0.1
    done
}

spin_start() {
    local msg="$1"
    (( FLAG_QUIET )) && return
    (( FLAG_TERSE )) && return
    _spinner "$msg" &
    SPIN_PID=$!
    disown "$SPIN_PID" 2>/dev/null
}

spin_stop() {
    local msg="${1:-}"
    if [[ -n "$SPIN_PID" ]]; then
        kill "$SPIN_PID" 2>/dev/null
        wait "$SPIN_PID" 2>/dev/null || true
        SPIN_PID=""
        # Clear the spinner line
        printf "\r\033[K"
    fi
}


# --- Root check ---
check_root() {
    if [[ $EUID -ne 0 ]]; then
        error "oob must be run as root"
        exit 1
    fi
}

# --- Help ---
show_banner() {
    (( FLAG_QUIET )) && return
    (( FLAG_TERSE )) && return
    case "$BANNER" in
        fancy)
            printf "${C_CYAN}"
            echo '┌──────────────────┐'
            echo "│  apt-oob v${OOB_VERSION}  │░"
            echo '└──────────────────┘░'
            echo '  ░░░░░░░░░░░░░░░░░░░'
            printf "${C_RESET}\n"
            ;;
        simple)
            printf "${C_CYAN}apt-oob - v%s${C_RESET}\n" "$OOB_VERSION"
            ;;
        none) ;;
    esac
}

show_help() {
    cat <<'HELP'
usage: oob <command> [name] [flags]

commands:
  install [name]     Install/update all configured packages, or a single package
  check [name]       Check available versions without installing
  remove <name>      Remove installed files, symlinks, and state for a package
  list               List all configured packages and their installed versions
  status <name>      Show detailed state and check for updates
  init               Create directory structure and install apt hook
  deinit             Remove the apt post-invoke hook

flags:
  -f, --force        install: reinstall regardless of version. remove: skip prompt
  -n, --dry-run      Show what would happen without making changes
  -v, --verbose      Increase terminal output detail
  -q, --quiet        Suppress terminal output; log to file only
  -t, --terse        Minimal plain-text output (no color, no banner) for apt hook mode
  -h, --help         Show this help message
  -V, --version      Show version
HELP
}

# --- Flag & argument parsing ---
COMMAND=""
TARGET_NAME=""

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force)   FLAG_FORCE=1 ;;
            -n|--dry-run) FLAG_DRYRUN=1 ;;
            -v|--verbose) FLAG_VERBOSE=1 ;;
            -q|--quiet)   FLAG_QUIET=1 ;;
            -t|--terse)   FLAG_TERSE=1 ;;
            -h|--help)    show_help; exit 0 ;;
            --version|-V) echo "oob ${OOB_VERSION}"; exit 0 ;;
            install|check|remove|list|status|init|deinit)
                COMMAND="$1"
                ;;
            *)
                if [[ -n "$COMMAND" && -z "$TARGET_NAME" ]]; then
                    TARGET_NAME="$1"
                else
                    error "unknown argument: $1"
                    exit 1
                fi
                ;;
        esac
        shift
    done

    if [[ -z "$COMMAND" ]]; then
        error "usage: oob <install|check|remove|list|status|init|deinit> [name] [flags]"
        exit 1
    fi
}

# --- Helper: conf.d loader ---
# Conf variables — reset between packages
_reset_conf() {
    NAME=""
    DOWNLOAD=""
    unset CHECKSUM
    unset GPG_KEY
    unset GPG_SIG_URL
    VERSION_CHECK=""
    INSTALL_DIR=""
    SYMLINKS=""
    SYMLINK_DIR=""
}

load_conf() {
    local conf_file="$1"
    _reset_conf
    # shellcheck disable=SC1090
    source "$conf_file"

    local missing=()
    [[ -z "$NAME" ]]          && missing+=("NAME")
    [[ -z "$DOWNLOAD" ]]      && missing+=("DOWNLOAD")
    [[ -z "$VERSION_CHECK" ]] && missing+=("VERSION_CHECK")
    [[ -z "$INSTALL_DIR" ]]   && missing+=("INSTALL_DIR")

    if [[ ${#missing[@]} -gt 0 ]]; then
        error "${conf_file}: missing required fields: ${missing[*]}"
        return 1
    fi

    # Warn on omitted (not "none") CHECKSUM
    if [[ -z "${CHECKSUM+x}" ]]; then
        warn "${NAME}: CHECKSUM not set, intent unclear — skipping checksum verification"
        CHECKSUM="none"
    fi
    # Warn on omitted GPG_KEY (only in verbose mode)
    if [[ -z "${GPG_KEY+x}" ]]; then
        _log "WARN" "${NAME}: GPG_KEY not set — skipping GPG signature verification"
        (( FLAG_VERBOSE )) && warn "${NAME}: GPG_KEY not set — skipping GPG signature verification"
        GPG_KEY=""
    fi

    return 0
}

# Find conf.d file by package NAME
find_conf_by_name() {
    local target="$1"
    for f in "${OOB_CONF}"/*; do
        [[ -f "$f" ]] || continue
        [[ "$f" == *.disabled ]] && continue
        _reset_conf
        # shellcheck disable=SC1090
        source "$f"
        if [[ "$NAME" == "$target" ]]; then
            echo "$f"
            return 0
        fi
    done
    return 1
}


# --- Helper: template variable substitution ---
expand_template() {
    local version="$1"
    local url="$2"

    local major minor revision
    IFS='.' read -r major minor revision <<< "$version"
    major="${major:-}"
    minor="${minor:-}"
    revision="${revision:-}"

    url="${url//%VERSION%/$version}"
    url="${url//%MAJOR%/$major}"
    url="${url//%MINOR%/$minor}"
    url="${url//%REVISION%/$revision}"
    echo "$url"
}

# --- Helper: resolve download URL ---
resolve_download_url() {
    local version="$1"
    local download="$2"

    if [[ "$download" == https://* ]]; then
        expand_template "$version" "$download"
    else
        local script="${OOB_DLOAD}/${download}"
        if [[ ! -x "$script" ]]; then
            error "${NAME}: download script not found or not executable: ${script}"
            return 1
        fi
        "$script" "$version"
    fi
}

# --- Helper: archive extraction ---
extract_archive() {
    local archive="$1"
    local dest="$2"

    mkdir -p "$dest"

    case "$archive" in
        *.tar.gz|*.tgz)    tar xzf "$archive" -C "$dest" ;;
        *.tar.xz|*.txz)    tar xJf "$archive" -C "$dest" ;;
        *.tar.bz2|*.tbz2)  tar xjf "$archive" -C "$dest" ;;
        *.tar)              tar xf  "$archive" -C "$dest" ;;
        *.zip)              unzip -qo "$archive" -d "$dest" ;;
        *)
            error "${NAME}: unsupported archive format: ${archive}"
            return 1
            ;;
    esac
}

# --- Helper: checksum verification ---
run_checksum() {
    local version="$1"
    local archive="$2"

    if [[ "$CHECKSUM" == "none" ]]; then
        return 0
    fi

    local script="${OOB_CHECKSUM}/${CHECKSUM}"
    if [[ ! -x "$script" ]]; then
        error "${NAME}: checksum script not found or not executable: ${script}"
        return 1
    fi

    local output
    output=$("$script" "$version") || {
        error "${NAME}: checksum script failed"
        return 1
    }

    local algo hash
    IFS=':' read -r algo hash <<< "$output"

    local computed
    case "$algo" in
        sha256) computed=$(sha256sum "$archive" | awk '{print $1}') ;;
        sha512) computed=$(sha512sum "$archive" | awk '{print $1}') ;;
        *)
            error "${NAME}: unsupported checksum algorithm: ${algo}"
            return 1
            ;;
    esac

    if [[ "$computed" != "$hash" ]]; then
        error "${NAME}: checksum mismatch (${algo})"
        error "  expected: ${hash}"
        error "  got:      ${computed}"
        return 1
    fi

    (( FLAG_VERBOSE )) && info "${NAME}: checksum verified (${algo})"
    return 0
}

# --- Helper: GPG signature verification ---
run_gpg_verify() {
    local version="$1"
    local archive="$2"

    if [[ -z "$GPG_KEY" ]]; then
        return 0
    fi

    local keyfile="${OOB_KEYS}/${GPG_KEY}"
    if [[ ! -f "$keyfile" ]]; then
        error "${NAME}: GPG key not found: ${keyfile}"
        return 1
    fi

    if [[ -z "${GPG_SIG_URL+x}" || -z "$GPG_SIG_URL" ]]; then
        error "${NAME}: GPG_KEY is set but GPG_SIG_URL is not defined"
        return 1
    fi

    local sig_url
    sig_url=$(expand_template "$version" "$GPG_SIG_URL")

    # Derive the signed file URL by stripping the signature extension (.asc or .sig)
    local signed_url="${sig_url%.asc}"
    [[ "$signed_url" == "$sig_url" ]] && signed_url="${sig_url%.sig}"

    local tmpdir
    tmpdir=$(mktemp -d "/tmp/oob-gpg.XXXXXX")
    local sigfile="${tmpdir}/signature.asc"
    local signedfile="${tmpdir}/signed_data"
    local keyring="${tmpdir}/keyring.gpg"

    # Download signature
    if ! curl -sfL -o "$sigfile" "$sig_url"; then
        rm -rf "$tmpdir"
        error "${NAME}: failed to download GPG signature from ${sig_url}"
        return 1
    fi

    # Download the signed file (e.g. SHA512SUMS)
    if [[ "$signed_url" != "$sig_url" ]]; then
        if ! curl -sfL -o "$signedfile" "$signed_url"; then
            rm -rf "$tmpdir"
            error "${NAME}: failed to download signed file from ${signed_url}"
            return 1
        fi
    else
        # If we can't derive a signed file URL, verify against the archive directly
        signedfile="$archive"
    fi

    # Import key into temporary keyring and verify
    gpg --batch --no-default-keyring --keyring "$keyring" --import "$keyfile" 2>/dev/null || {
        rm -rf "$tmpdir"
        error "${NAME}: failed to import GPG key: ${keyfile}"
        return 1
    }

    gpg --batch --no-default-keyring --keyring "$keyring" --verify "$sigfile" "$signedfile" 2>/dev/null
    local rc=$?
    rm -rf "$tmpdir"

    if [[ $rc -ne 0 ]]; then
        error "${NAME}: GPG signature verification failed"
        return 1
    fi

    (( FLAG_VERBOSE )) && info "${NAME}: GPG signature verified"
    return 0
}


# --- Helper: verification summary ---
print_verify_summary() {
    local name="$1"
    local gpg_status="$2"
    local checksum_status="$3"

    local has_checks=0
    [[ "$checksum_status" != "--" ]] && has_checks=1
    [[ "$gpg_status" != "--" ]] && has_checks=1

    # Normal mode: only print if at least one check was configured
    # Verbose mode: always print
    if (( ! has_checks && ! FLAG_VERBOSE )); then
        return
    fi

    local gpg_tag checksum_tag
    case "$gpg_status" in
        OK)   gpg_tag="{GREEN}OK{RESET}" ;;
        FAIL) gpg_tag="{RED}FAIL{RESET}" ;;
        --)   gpg_tag="{YELLOW}--{RESET}" ;;
    esac
    case "$checksum_status" in
        OK)   checksum_tag="{GREEN}OK{RESET}" ;;
        FAIL) checksum_tag="{RED}FAIL{RESET}" ;;
        --)   checksum_tag="{YELLOW}--{RESET}" ;;
    esac

    fmt_print "INFO" "${name}: gpg ${gpg_tag}  checksum ${checksum_tag}"
}

# --- Helper: symlink management ---
create_symlinks() {
    local install_dir="$1"
    local symlink_dir="$2"
    local symlinks="$3"
    local version="${4:-}"
    local resolved=""

    [[ -z "$symlinks" || "$symlinks" == "none" ]] && return 0

    mkdir -p "$symlink_dir"

    local IFS='|'
    for entry in $symlinks; do
        local linkname="${entry%%:*}"
        local relpath="${entry#*:}"
        # Expand template variables in relpath if version provided
        if [[ -n "$version" ]]; then
            relpath=$(expand_template "$version" "$relpath")
        fi
        local target="${install_dir}/${relpath}"
        local linkpath="${symlink_dir}/${linkname}"

        if (( FLAG_DRYRUN )); then
            info "${NAME}: would symlink ${linkpath} -> ${target}"
        else
            ln -sf "$target" "$linkpath"
            (( FLAG_VERBOSE )) && info "${NAME}: symlink ${linkpath} -> ${target}"
        fi

        [[ -n "$resolved" ]] && resolved+="|"
        resolved+="${linkname}:${linkpath}"
    done

    echo "$resolved"
}

remove_symlinks() {
    local symlinks="$1"

    local IFS='|'
    for entry in $symlinks; do
        local linkpath="${entry#*:}"
        if [[ -L "$linkpath" ]]; then
            if (( FLAG_DRYRUN )); then
                info "would remove symlink ${linkpath}"
            else
                rm -f "$linkpath"
                (( FLAG_VERBOSE )) && info "removed symlink ${linkpath}"
            fi
        fi
    done
}

# Check symlinks for a package — returns number of broken links
# If fix=1, recreates broken symlinks using conf.d SYMLINKS and INSTALL_DIR
check_symlinks() {
    local name="$1"
    local state_symlinks="$2"
    local fix="${3:-0}"
    local broken=0

    [[ -z "$state_symlinks" ]] && return 0

    local IFS='|'
    for entry in $state_symlinks; do
        local linkname="${entry%%:*}"
        local linkpath="${entry#*:}"

        if [[ ! -L "$linkpath" ]]; then
            warn "${name}: symlink missing: ${linkpath}"
            broken=$((broken + 1))
        elif [[ ! -e "$linkpath" ]]; then
            warn "${name}: broken symlink: ${linkpath} (target missing)"
            broken=$((broken + 1))
            if (( fix )); then
                rm -f "$linkpath"
            fi
        else
            (( FLAG_VERBOSE )) && info "${name}: symlink OK: ${linkpath}"
        fi
    done

    # Recreate broken symlinks from conf.d if fix requested
    if (( fix && broken > 0 )); then
        local conf_file
        if conf_file=$(find_conf_by_name "$name" 2>/dev/null); then
            load_conf "$conf_file" 2>/dev/null || return "$broken"
            # Save conf.d SYMLINKS (relative paths) before read_state overwrites it
            local conf_symlinks="$SYMLINKS"
            local conf_install_dir="$INSTALL_DIR"
            local conf_symlink_dir="$SYMLINK_DIR"
            if read_state "$name"; then
                local resolved
                resolved=$(create_symlinks "$conf_install_dir" "$conf_symlink_dir" "$conf_symlinks" "$INSTALLED_VERSION")
                # Verify recreated symlinks
                local IFS='|'
                local all_ok=1
                for entry in $resolved; do
                    local lpath="${entry#*:}"
                    local target
                    target=$(readlink -f "$lpath" 2>/dev/null)
                    if [[ ! -e "$target" ]]; then
                        warn "${name}: symlink ${lpath} target does not exist"
                        all_ok=0
                    elif [[ ! -r "$target" ]]; then
                        warn "${name}: symlink ${lpath} target is not readable"
                        all_ok=0
                    elif [[ ! -x "$target" ]]; then
                        warn "${name}: symlink ${lpath} target is not executable"
                        all_ok=0
                    fi
                done
                if (( all_ok )); then
                    success "${name}: recreated ${broken} symlink(s) — verified OK"
                else
                    warn "${name}: recreated ${broken} symlink(s) — some targets have issues"
                fi
            fi
        fi
    fi

    return "$broken"
}

# --- Helper: state file management ---
read_state() {
    local name="$1"
    local state_file="${OOB_STATE}/${name}"

    INSTALLED_VERSION=""
    INSTALL_DATE=""
    INSTALL_PATH=""
    STATE_SYMLINKS=""

    if [[ -f "$state_file" ]]; then
        # shellcheck disable=SC1090
        source "$state_file"
        STATE_SYMLINKS="${SYMLINKS:-}"
        return 0
    fi
    return 1
}

write_state() {
    local name="$1"
    local version="$2"
    local install_path="$3"
    local resolved_symlinks="$4"

    mkdir -p "$OOB_STATE"

    local tmp
    tmp=$(mktemp "${OOB_STATE}/.${name}.XXXXXX")
    cat > "$tmp" <<EOF
INSTALLED_VERSION="${version}"
INSTALL_DATE="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
INSTALL_PATH="${install_path}"
SYMLINKS="${resolved_symlinks}"
EOF
    mv "$tmp" "${OOB_STATE}/${name}"
}

# --- Helper: integrity check ---
# Checks that state and install directory agree.
# Sets INTEGRITY to: ok, stale_state, orphaned, not_installed
# Must be called after load_conf and read_state.
check_integrity() {
    local name="$1"
    local install_dir="$2"
    local has_state=0
    local has_dir=0

    [[ -f "${OOB_STATE}/${name}" ]] && has_state=1
    [[ -d "$install_dir" ]] && has_dir=1

    if (( has_state && has_dir )); then
        INTEGRITY="ok"
    elif (( has_state && ! has_dir )); then
        INTEGRITY="stale_state"
        warn "${name}: state file exists but install directory is missing — stale state"
    elif (( ! has_state && has_dir )); then
        INTEGRITY="orphaned"
        warn "${name}: install directory exists but no state file — orphaned install"
    else
        INTEGRITY="not_installed"
    fi
}

# --- Helper: version check ---
run_version_check() {
    local name="$1"
    local version_check="$2"

    local script="${OOB_CHECKVER}/${version_check}"
    if [[ ! -x "$script" ]]; then
        error "${name}: version check script not found or not executable: ${script}"
        return 1
    fi

    local version
    version=$("$script") || {
        error "${name}: version check failed"
        return 1
    }

    if [[ -z "$version" ]]; then
        error "${name}: version check returned empty string"
        return 1
    fi

    echo "$version"
}


# --- Command: install ---
cmd_install_package() {
    local conf_file="$1"

    load_conf "$conf_file" || return 1

    local available
    available=$(run_version_check "$NAME" "$VERSION_CHECK") || return 1

    # Check if already installed at this version
    check_integrity "$NAME" "$INSTALL_DIR"
    if [[ "$INTEGRITY" == "ok" ]]; then
        read_state "$NAME"
        if [[ "$INSTALLED_VERSION" == "$available" ]] && (( ! FLAG_FORCE )); then
            fmt_print "INFO" "${NAME}: {CYAN}up to date (${available})"
            return 0
        fi
    elif [[ "$INTEGRITY" == "stale_state" ]]; then
        # State exists but files are gone — remove stale state and proceed
        rm -f "${OOB_STATE}/${NAME}"
    fi

    if (( FLAG_DRYRUN )); then
        info "${NAME}: would install version ${available}"
        info "${NAME}: would download from $(resolve_download_url "$available" "$DOWNLOAD")"
        [[ "$CHECKSUM" != "none" ]] && info "${NAME}: would verify checksum via ${CHECKSUM}"
        [[ -n "$GPG_KEY" ]] && info "${NAME}: would verify GPG signature via ${GPG_KEY}"
        info "${NAME}: would extract to ${INSTALL_DIR}"
        create_symlinks "$INSTALL_DIR" "$SYMLINK_DIR" "$SYMLINKS" > /dev/null
        return 0
    fi

    # Download
    local tmpdir
    tmpdir=$(mktemp -d "/tmp/oob.${NAME}.XXXXXX")
    # shellcheck disable=SC2064
    trap "rm -rf '$tmpdir'" RETURN

    local url
    url=$(resolve_download_url "$available" "$DOWNLOAD") || return 1

    local filename
    filename=$(basename "$url" | sed 's/?.*//')
    local archive="${tmpdir}/${filename}"

    fmt_print "INFO" "${NAME}: {CYAN}downloading ${available}..."
    spin_start "${NAME}: downloading ${available}"
    if ! curl -sfL -o "$archive" "$url"; then
        spin_stop
        error "${NAME}: download failed"
        return 1
    fi
    spin_stop

    # Checksum
    local checksum_status="--"
    local gpg_status="--"
    local verify_failed=0

    if [[ "$CHECKSUM" != "none" ]]; then
        if run_checksum "$available" "$archive"; then
            checksum_status="OK"
        else
            checksum_status="FAIL"
            verify_failed=1
        fi
    fi

    # Signature (only if checksum didn't fail)
    if (( ! verify_failed )) && [[ -n "$GPG_KEY" ]]; then
        if run_gpg_verify "$available" "$archive"; then
            gpg_status="OK"
        else
            gpg_status="FAIL"
            verify_failed=1
        fi
    fi

    print_verify_summary "$NAME" "$gpg_status" "$checksum_status"

    if (( verify_failed )); then
        error "${NAME}: verification failed — install aborted"
        return 1
    fi

    # Remove old install
    if [[ -d "$INSTALL_DIR" ]]; then
        (( FLAG_VERBOSE )) && info "${NAME}: removing old install at ${INSTALL_DIR}"
        rm -rf "$INSTALL_DIR"
    fi

    # Extract
    fmt_print "INFO" "${NAME}: {CYAN}extracting to ${INSTALL_DIR}"
    spin_start "${NAME}: extracting"
    extract_archive "$archive" "$INSTALL_DIR" || { spin_stop; return 1; }
    spin_stop

    # Check for restrictive permissions after extraction
    local dir_perms
    dir_perms=$(find "$INSTALL_DIR" -type d ! -perm -o=rx -print -quit 2>/dev/null)
    if [[ -n "$dir_perms" ]]; then
        warn "${NAME}: extracted directories have restrictive permissions — fixing to 755"
        find "$INSTALL_DIR" -type d -exec chmod 755 {} +
    fi
    local file_perms
    file_perms=$(find "$INSTALL_DIR" -type f ! -perm -o=r -print -quit 2>/dev/null)
    if [[ -n "$file_perms" ]]; then
        warn "${NAME}: extracted files have restrictive permissions — fixing to 644/755"
        find "$INSTALL_DIR" -type f -executable -exec chmod 755 {} +
        find "$INSTALL_DIR" -type f ! -executable -exec chmod 644 {} +
    fi

    # Symlinks
    local resolved
    resolved=$(create_symlinks "$INSTALL_DIR" "$SYMLINK_DIR" "$SYMLINKS" "$available")

    # State
    write_state "$NAME" "$available" "$INSTALL_DIR" "$resolved"

    fmt_print "INFO" "${NAME}: {GREEN}installed version ${available}"
    return 0
}

cmd_install() {
    if [[ -n "$TARGET_NAME" ]]; then
        local conf_file
        conf_file=$(find_conf_by_name "$TARGET_NAME") || {
            error "no configuration found for package: ${TARGET_NAME}"
            return 1
        }
        cmd_install_package "$conf_file" || true
    else
        for conf_file in "${OOB_CONF}"/*; do
            [[ -f "$conf_file" ]] || continue
            [[ "$conf_file" == *.disabled ]] && continue
            cmd_install_package "$conf_file" || true
        done
    fi
}

# --- Command: check ---
cmd_check() {
    local confs=()
    local count_uptodate=0
    local count_updates=0
    local count_notinstalled=0

    if [[ -n "$TARGET_NAME" ]]; then
        local conf_file
        conf_file=$(find_conf_by_name "$TARGET_NAME") || {
            error "no configuration found for package: ${TARGET_NAME}"
            return 1
        }
        confs+=("$conf_file")
    else
        for f in "${OOB_CONF}"/*; do
            [[ -f "$f" ]] && [[ "$f" != *.disabled ]] && confs+=("$f")
        done
    fi

    for conf_file in "${confs[@]}"; do
        load_conf "$conf_file" || continue

        local available
        available=$(run_version_check "$NAME" "$VERSION_CHECK") || continue

        check_integrity "$NAME" "$INSTALL_DIR"

        if [[ "$INTEGRITY" == "stale_state" || "$INTEGRITY" == "orphaned" ]]; then
            # Warnings already printed by check_integrity
            :
        fi

        if [[ "$INTEGRITY" == "ok" ]]; then
            read_state "$NAME"
            # Check and fix broken symlinks
            check_symlinks "$NAME" "$STATE_SYMLINKS" 1 || true
            if [[ "$INSTALLED_VERSION" == "$available" ]]; then
                fmt_print "INFO" "{WHITE}${NAME}: {CYAN}installed=${INSTALLED_VERSION} available=${available} (up to date)"
                count_uptodate=$((count_uptodate + 1))
            else
                fmt_print "INFO" "{WHITE}${NAME}: {MAGENTA}installed=${INSTALLED_VERSION} available=${available}"
                count_updates=$((count_updates + 1))
            fi
        else
            fmt_print "INFO" "{WHITE}${NAME}: {MAGENTA}not installed, available=${available}"
            count_notinstalled=$((count_notinstalled + 1))
        fi
    done

    # Summary
    local total=$((count_updates + count_notinstalled))
    if (( total > 0 )); then
        local parts=()
        (( count_updates > 0 )) && parts+=("${count_updates} update(s)")
        (( count_notinstalled > 0 )) && parts+=("${count_notinstalled} not installed")
        local summary
        summary=$(IFS=', '; echo "${parts[*]}")
        warn "${summary}. Run 'oob install' to install/update."
    else
        fmt_print "INFO" "{CYAN}all packages up to date."
    fi
}


# --- Command: remove ---
cmd_remove() {
    if [[ -z "$TARGET_NAME" ]]; then
        error "usage: oob remove <name>"
        return 1
    fi

    if ! read_state "$TARGET_NAME"; then
        # Check for orphaned install
        local conf_file
        if conf_file=$(find_conf_by_name "$TARGET_NAME" 2>/dev/null); then
            load_conf "$conf_file" || return 1
            check_integrity "$NAME" "$INSTALL_DIR"
            if [[ "$INTEGRITY" == "orphaned" ]]; then
                if (( ! FLAG_FORCE )); then
                    printf "Remove orphaned install at %s? [y/N] " "$INSTALL_DIR"
                    local answer
                    read -r answer
                    case "$answer" in
                        [yY]|[yY][eE][sS]) ;;
                        *) info "aborted"; return 0 ;;
                    esac
                fi
                if (( ! FLAG_DRYRUN )); then
                    rm -rf "$INSTALL_DIR"
                    success "${TARGET_NAME}: removed orphaned install"
                else
                    info "${TARGET_NAME}: would remove orphaned install at ${INSTALL_DIR}"
                fi
                return 0
            fi
        fi
        error "${TARGET_NAME}: not installed"
        return 1
    fi

    if (( FLAG_DRYRUN )); then
        info "${TARGET_NAME}: would remove ${INSTALL_PATH}"
        [[ -n "$STATE_SYMLINKS" ]] && remove_symlinks "$STATE_SYMLINKS"
        info "${TARGET_NAME}: would remove state file"
        return 0
    fi

    if (( ! FLAG_FORCE )); then
        printf "Remove %s (version %s)? [y/N] " "$TARGET_NAME" "$INSTALLED_VERSION"
        local answer
        read -r answer
        case "$answer" in
            [yY]|[yY][eE][sS]) ;;
            *) info "aborted"; return 0 ;;
        esac
    fi

    # Remove symlinks
    [[ -n "$STATE_SYMLINKS" ]] && remove_symlinks "$STATE_SYMLINKS"

    # Remove installed files
    spin_start "${TARGET_NAME}: removing"
    if [[ -d "$INSTALL_PATH" ]]; then
        rm -rf "$INSTALL_PATH"
        info "${TARGET_NAME}: removed ${INSTALL_PATH}"
    fi

    # Also try INSTALL_DIR from conf if different from INSTALL_PATH
    local conf_file
    if conf_file=$(find_conf_by_name "$TARGET_NAME" 2>/dev/null); then
        load_conf "$conf_file" 2>/dev/null || true
        if [[ -d "$INSTALL_DIR" && "$INSTALL_DIR" != "$INSTALL_PATH" ]]; then
            rm -rf "$INSTALL_DIR"
            info "${TARGET_NAME}: removed ${INSTALL_DIR}"
        fi
    fi

    # Also remove the parent directory if empty
    local parent
    parent=$(dirname "$INSTALL_PATH")
    if [[ -d "$parent" ]] && [[ -z "$(ls -A "$parent" 2>/dev/null)" ]]; then
        rmdir "$parent" 2>/dev/null || true
    fi
    spin_stop

    # Remove state
    rm -f "${OOB_STATE}/${TARGET_NAME}"

    fmt_print "INFO" "${TARGET_NAME}: {GREEN}removed"
}

# --- Command: list ---
cmd_list() {
    for conf_file in "${OOB_CONF}"/*; do
        [[ -f "$conf_file" ]] || continue
        [[ "$conf_file" == *.disabled ]] && continue
        _reset_conf
        # shellcheck disable=SC1090
        source "$conf_file"
        [[ -z "$NAME" ]] && continue

        if read_state "$NAME"; then
            check_integrity "$NAME" "${OOB_LIVE}/${NAME}"
            if [[ "$INTEGRITY" == "stale_state" ]]; then
                warn "${NAME}: ${INSTALLED_VERSION} (state only — files missing)"
            else
                info "${NAME}: ${INSTALLED_VERSION}"
            fi
        else
            check_integrity "$NAME" "${OOB_LIVE}/${NAME}"
            if [[ "$INTEGRITY" == "orphaned" ]]; then
                warn "${NAME}: orphaned install (no state file)"
            else
                info "${NAME}: configured, not installed"
            fi
        fi
    done
}

# --- Command: status ---
cmd_status() {
    if [[ -z "$TARGET_NAME" ]]; then
        error "usage: oob status <name>"
        return 1
    fi

    local conf_file
    conf_file=$(find_conf_by_name "$TARGET_NAME") || {
        error "no configuration found for package: ${TARGET_NAME}"
        return 1
    }

    load_conf "$conf_file" || return 1

    check_integrity "$NAME" "$INSTALL_DIR"

    if [[ "$INTEGRITY" == "ok" ]]; then
        read_state "$NAME"
        bold "${NAME}"
        info "  version:  ${INSTALLED_VERSION}"
        info "  date:     ${INSTALL_DATE}"
        info "  path:     ${INSTALL_PATH}"
        info "  symlinks: ${STATE_SYMLINKS}"
        # Check symlinks (report only, no fix in status)
        check_symlinks "$NAME" "$STATE_SYMLINKS" 0 || true
    elif [[ "$INTEGRITY" == "stale_state" ]]; then
        read_state "$NAME"
        bold "${NAME}"
        warn "  version:  ${INSTALLED_VERSION} (state only — files missing)"
        info "  date:     ${INSTALL_DATE}"
        info "  path:     ${INSTALL_PATH}"
    elif [[ "$INTEGRITY" == "orphaned" ]]; then
        bold "${NAME}"
        warn "  orphaned install (no state file)"
        info "  path:     ${INSTALL_DIR}"
    else
        info "${NAME}: not installed"
    fi

    # Check for updates
    local available
    available=$(run_version_check "$NAME" "$VERSION_CHECK") || return 0

    if [[ -n "${INSTALLED_VERSION:-}" && "$INSTALLED_VERSION" == "$available" ]]; then
        success "${NAME}: up to date (${available})"
    elif [[ -n "${INSTALLED_VERSION:-}" ]]; then
        highlight "${NAME}: update available ${INSTALLED_VERSION} -> ${available}"
    else
        highlight "${NAME}: available version ${available}"
    fi
}

# --- Command: init ---
cmd_init() {
    # Create directory structure
    local dirs=("$OOB_CONF" "$OOB_CHECKVER" "$OOB_DLOAD" "$OOB_CHECKSUM" "$OOB_KEYS" "$OOB_LIVE" "$OOB_STATE" "${OOB_BASE}/bin")
    for d in "${dirs[@]}"; do
        if (( FLAG_DRYRUN )); then
            [[ -d "$d" ]] || info "would create directory: ${d}"
        else
            if [[ ! -d "$d" ]]; then
                mkdir -p "$d"
                (( FLAG_VERBOSE )) && info "created directory: ${d}"
            fi
        fi
    done

    # Copy oob executable into place
    local self_path
    self_path="$(readlink -f "${BASH_SOURCE[0]}")"
    local dest="${OOB_BASE}/bin/oob"
    if [[ "$self_path" == "$dest" ]]; then
        (( FLAG_VERBOSE )) && info "oob already installed at ${dest}"
    elif (( FLAG_DRYRUN )); then
        info "would install ${self_path} to ${dest}"
    else
        cp "$self_path" "$dest"
        chmod +x "$dest"
        success "installed oob to ${dest}"
    fi

    # Write default config if it doesn't exist
    local conf="${OOB_CONF_FILE:-/etc/apt-oob.conf}"
    if [[ -f "$conf" ]]; then
        info "config exists: ${conf}"
    elif (( FLAG_DRYRUN )); then
        info "would write default config to ${conf}"
    else
        cat > "$conf" <<'CONF'
# /etc/apt-oob.conf — global configuration for apt-oob
#
# All values below show the built-in defaults. Uncomment and modify to override.

# Root directory for all apt-oob files (conf.d, checkver, dload, checksum,
# keys, live, state). All subdirectory paths are derived from this.
#OOB_BASE="/usr/local/apt-oob"

# Log file path. All oob output is appended here in syslog format.
#LOG_FILE="/var/log/apt-oob.log"

# Banner style displayed on startup: fancy, simple, or none.
#BANNER="fancy"
CONF
        success "wrote default config: ${conf}"
    fi

    # Install example firefox config if conf.d is empty
    if [[ -z "$(ls -A "$OOB_CONF" 2>/dev/null)" ]]; then
        if (( FLAG_DRYRUN )); then
            info "would write example firefox config to ${OOB_CONF}/10-firefox"
        else
            cat > "${OOB_CONF}/10-firefox" <<'CONF'
# This file is sourced by oob. Shell variables (${VAR}) expand at load time.
# %WORD% are template variables. See oob(1) for details.

NAME="firefox"
DOWNLOAD="https://download-installer.cdn.mozilla.net/pub/firefox/releases/%VERSION%/linux-x86_64/en-US/firefox-%VERSION%.tar.xz"
CHECKSUM="firefox-verify.sh"
GPG_KEY="firefox.gpg"
GPG_SIG_URL="https://releases.mozilla.org/pub/firefox/releases/%VERSION%/SHA512SUMS.asc"
VERSION_CHECK="firefox-check.sh"
INSTALL_DIR="${OOB_LIVE}/${NAME}"
SYMLINKS="firefox:firefox/firefox"
SYMLINK_DIR="/usr/local/bin"
CONF

            cat > "${OOB_CHECKVER}/firefox-check.sh" <<'SCRIPT'
#!/bin/bash
curl -sf 'https://product-details.mozilla.org/1.0/firefox_versions.json' \
  | grep -oP '"LATEST_FIREFOX_VERSION"\s*:\s*"\K[^"]+'
SCRIPT
            chmod +x "${OOB_CHECKVER}/firefox-check.sh"

            cat > "${OOB_CHECKSUM}/firefox-verify.sh" <<'SCRIPT'
#!/bin/bash
VERSION="$1"
[ -z "$VERSION" ] && exit 1
URL="https://download-installer.cdn.mozilla.net/pub/firefox/releases/${VERSION}/SHA512SUMS"
HASH=$(curl -sf "$URL" | grep "linux-x86_64/en-US/firefox-${VERSION}.tar.xz" | awk '{print $1}')
[ -z "$HASH" ] && exit 1
echo "sha512:${HASH}"
SCRIPT
            chmod +x "${OOB_CHECKSUM}/firefox-verify.sh"

            success "wrote example firefox config to ${OOB_CONF}/10-firefox"
        fi
    fi

    # Install apt hook
    if [[ -f "$APT_HOOK" ]]; then
        warn "apt hook already exists: ${APT_HOOK}"
        if (( ! FLAG_FORCE )); then
            printf "Overwrite? [y/N] "
            local answer
            read -r answer
            case "$answer" in
                [yY]|[yY][eE][sS]) ;;
                *) info "aborted"; return 0 ;;
            esac
        fi
    fi

    if (( FLAG_DRYRUN )); then
        info "would write apt hook to ${APT_HOOK}"
        return 0
    fi

    cat > "$APT_HOOK" <<'EOF'
# /etc/apt/apt.conf.d/99-apt-oob
# Check for oob updates after apt update
APT::Update::Post-Invoke-Success {"if [ -x /usr/local/apt-oob/bin/oob ]; then /usr/local/apt-oob/bin/oob check --terse; fi";};
# Install oob updates after apt upgrade/full-upgrade
DPkg::Post-Invoke {"if [ -x /usr/local/apt-oob/bin/oob ]; then /usr/local/apt-oob/bin/oob install --terse; fi";};
EOF

    success "apt hook installed: ${APT_HOOK}"
}

# --- Command: deinit ---
cmd_deinit() {
    if [[ ! -f "$APT_HOOK" ]]; then
        warn "apt hook not found: ${APT_HOOK}"
        return 0
    fi

    if (( FLAG_DRYRUN )); then
        info "would remove apt hook: ${APT_HOOK}"
        return 0
    fi

    rm -f "$APT_HOOK"
    success "apt hook removed: ${APT_HOOK}"
}

# --- Main ---
main() {
    parse_args "$@"
    check_root

    # Auto-quiet when stdout is not a terminal (unless -v or -t explicitly set)
    if [[ ! -t 1 ]] && (( ! FLAG_VERBOSE )) && (( ! FLAG_TERSE )); then
        FLAG_QUIET=1
    fi

    show_banner

    # Ensure log file exists
    touch "$LOG_FILE" 2>/dev/null || true

    case "$COMMAND" in
        install) cmd_install ;;
        check)   cmd_check ;;
        remove)  cmd_remove ;;
        list)    cmd_list ;;
        status)  cmd_status ;;
        init)    cmd_init ;;
        deinit)  cmd_deinit ;;
    esac
}

# Allow sourcing without executing (for unit tests)
if [[ "${OOB_SOURCED:-0}" != "1" ]]; then
    main "$@"
fi
